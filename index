<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Local Vendor Market</title>
<style>
/* 1. BASIC STYLES FOR THE PAGE */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1604719312566-8912e9227c6a?auto=format&fit=crop&w=1600&q=80') no-repeat center center fixed;
    background-size: cover;
    padding-bottom: 50px;
    color: #333;
}
/* NAVIGATION BAR */
.navbar {
    background-color: rgba(26, 37, 47, 0.95);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
}
.navbar .logo {
    font-size: 20px;
    font-weight: bold;
}
.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
}
.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 15px;
}
header {
    background-color: rgba(44, 62, 80, 0.85);
    color: white;
    text-align: center;
    padding: 25px 20px;
    border-bottom: 3px solid #e67e22;
}
/* FILTER BUTTONS */
.filter-container {
    text-align: center;
    margin: 20px 0;
}
.filter-btn {
    background-color: rgba(127, 140, 141, 0.9);
    color: white;
    border: none;
    margin: 0 5px;
    padding: 6px 14px;
    font-size: 13px;
    border-radius: 4px;
    cursor: pointer;
}
.filter-btn.active {
    background-color: #2c3e50;
}
/* 2. CART SUMMARY BAR AT THE TOP */
.cart-bar {
    background-color: rgba(230, 126, 34, 0.95);
    color: white;
    text-align: center;
    padding: 12px;
    font-weight: bold;
    font-size: 16px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}
/* 3. PRODUCT GRID LAYOUT */
.container {
    max-width: 950px;
    margin: 20px auto;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
}
/* 4. INDIVIDUAL PRODUCT CARD */
.card {
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid #ccc;
    border-radius: 8px;
    width: 260px;
    padding: 15px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
}
.card img {
    width: 100%;
    height: 170px;
    object-fit: cover;
    border-radius: 5px;
}
.vendor {
    color: #27ae60;
    font-size: 13px;
    font-weight: bold;
    margin-top: 5px;
}
.category {
    color: #7f8c8d;
    font-size: 11px;
    text-transform: uppercase;
    font-weight: bold;
    margin-top: 3px;
}
.price {
    font-size: 18px;
    color: #333;
    font-weight: bold;
    margin: 10px 0;
}
/* 5. BUTTONS */
button {
    background-color: #2980b9;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
}
button:hover {
    background-color: #3498db;
}
.checkout-btn {
    background-color: #27ae60;
    margin-left: 15px;
}
.checkout-btn:hover {
    background-color: #2ecc71;
}
/* 6. GENERAL INFO SECTION (FOOTER) */
.info-section {
    background-color: rgba(26, 37, 47, 0.95);
    color: #ecf0f1;
    text-align: center;
    padding: 25px 20px;
    margin-top: 40px;
    border-top: 4px solid #e67e22;
    font-size: 14px;
    line-height: 1.6;
}
.info-section h3 {
    color: #e67e22;
    margin-top: 0;
    margin-bottom: 10px;
}
.info-section p {
    margin: 5px 0;
    color: #bdc3c7;
}
</style>
</head>
<body>

<!-- NAVIGATION BAR (MENU) -->
<nav class="navbar">
    <div class="logo">🛒 LocalMarket</div>
    <ul class="nav-links">
        <li><a href="#" onclick="filterProducts('all')">Home</a></li>
        <li><a href="#" onclick="filterProducts('fruits')">Fruits</a></li>
        <li><a href="#" onclick="filterProducts('grocery')">Grocery</a></li>
        <li><a href="#" onclick="filterProducts('clothes')">Clothes</a></li>
        <li><a href="#">Cart (<span id="nav-cart-count">0</span>)</a></li>
    </ul>
</nav>

<!-- PAGE HEADER -->
<header>
    <h1>Local Market Online Store</h1>
    <p>Shop Clothes, Fresh Fruits & Groceries from Local Small Vendors</p>
</header>

<!-- CART DISPLAY BAR -->
<div class="cart-bar">
    Total Items: <span id="cart-count">0</span> | Total Bill: ₹<span id="cart-total">0</span>
    <button class="checkout-btn" onclick="alert('Proceeding to checkout with total amount: ₹' + totalPrice)">Pay Bill Now</button>
</div>

<!-- CATEGORY FILTER BUTTONS -->
<div class="filter-container">
    <button class="filter-btn active" onclick="filterProducts('all', this)">All Products</button>
    <button class="filter-btn" onclick="filterProducts('fruits', this)">Fruits</button>
    <button class="filter-btn" onclick="filterProducts('grocery', this)">Grocery</button>
    <button class="filter-btn" onclick="filterProducts('clothes', this)">Clothes</button>
</div>

<!-- PRODUCTS SECTION -->
<div class="container">
    <!-- FRUITS -->
    <div class="card" data-category="fruits">
        <img src="https://images.unsplash.com/photo-1560806887-1e4cd0b6cbd6?auto=format&fit=crop&w=400&q=80" alt="Fresh Red Apples">
        <h3>Fresh Red Apples (1 kg)</h3>
        <div class="category">Category: Fruits</div>
        <div class="vendor">Vendor: Sunny Orchards</div>
        <div class="price">₹120</div>
        <button onclick="addToCart(120)">Add to Cart</button>
    </div>
    
    <div class="card" data-category="fruits">
        <img src="https://images.unsplash.com/photo-1571771894821-ce9b6c11b08e?auto=format&fit=crop&w=400&q=80" alt="Organic Bananas">
        <h3>Fresh Bananas (1 Dozen)</h3>
        <div class="category">Category: Fruits</div>
        <div class="vendor">Vendor: Green Acres Farm</div>
        <div class="price">₹60</div>
        <button onclick="addToCart(60)">Add to Cart</button>
    </div>

    <!-- GROCERY -->
    <div class="card" data-category="grocery">
        <img src="https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&w=400&q=80" alt="Basmati Rice">
        <h3>Basmati Rice (5 kg)</h3>
        <div class="category">Category: Grocery</div>
        <div class="vendor">Vendor: Heritage Grains</div>
        <div class="price">₹450</div>
        <button onclick="addToCart(450)">Add to Cart</button>
    </div>
    
    <div class="card" data-category="grocery">
        <img src="https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?auto=format&fit=crop&w=400&q=80" alt="Extra Virgin Olive Oil">
        <h3>Pure Cooking Oil (1L)</h3>
        <div class="category">Category: Grocery</div>
        <div class="vendor">Vendor: Pure Pantry</div>
        <div class="price">₹180</div>
        <button onclick="addToCart(180)">Add to Cart</button>
    </div>

    <!-- CLOTHES -->
    <div class="card" data-category="clothes">
        <img src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=400&q=80" alt="Cotton T-Shirt">
        <h3>Cotton T-Shirt</h3>
        <div class="category">Category: Clothes</div>
        <div class="vendor">Vendor: Urban Stitch</div>
        <div class="price">₹499</div>
        <button onclick="addToCart(499)">Add to Cart</button>
    </div>
    
    <div class="card" data-category="clothes">
        <img src="https://images.unsplash.com/photo-1604176354204-9268737828e4?auto=format&fit=crop&w=400&q=80" alt="Denim Jacket">
        <h3>Classic Denim Jacket</h3>
        <div class="category">Category: Clothes</div>
        <div class="vendor">Vendor: Thread & Needle</div>
        <div class="price">₹1,299</div>
        <button onclick="addToCart(1299)">Add to Cart</button>
    </div>
</div>

<!-- GENERAL INFORMATION SECTION -->
<div class="info-section">
    <h3>About Local Vendor Market</h3>
    <p>Connecting you directly with trusted local vendors, farmers, and small businesses for fresh goods and quality apparel.</p>
    <p>📍 Location: Main Market Street &nbsp;|&nbsp; 📞 Contact: +91 98765 43210 &nbsp;|&nbsp; ⏰ Open Daily: 8:00 AM - 9:00 PM</p>
</div>

<!-- JAVASCRIPT FOR CART AND FILTERING -->
<script>
let itemCount = 0;
let totalPrice = 0;

function addToCart(price) {
    itemCount = itemCount + 1;
    totalPrice = totalPrice + price;
    document.getElementById("cart-count").innerText = itemCount;
    document.getElementById("nav-cart-count").innerText = itemCount;
    document.getElementById("cart-total").innerText = totalPrice;
}

function filterProducts(category, element) {
    // 1. Get all product cards
    const cards = document.querySelectorAll('.card');
    
    // 2. Loop through cards and toggle display
    cards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        if (category === 'all' || cardCategory === category) {
            card.style.display = 'block';
        } else {
            card.style.display = 'none';
        }
    });

    // 3. Update active button highlights (if called via filter buttons)
    if (element) {
        const buttons = document.querySelectorAll('.filter-btn');
        buttons.forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');
    }
}
</script>
</body>
</html>
